{
  "name": "osf-cli-go",
  "version": "0.3.1",
  "description": "Read-only Open Science Framework MCP tools for Gemini CLI.",
  "settings": [
    {
      "name": "OSF personal access token",
      "description": "Preferred OSF personal access token.",
      "envVar": "OSF_TOKEN",
      "sensitive": true
    },
    {
      "name": "OSF username",
      "description": "Optional OSF username fallback.",
      "envVar": "OSF_USERNAME",
      "sensitive": true
    },
    {
      "name": "OSF password",
      "description": "Optional OSF password fallback.",
      "envVar": "OSF_PASSWORD",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "osf": {
      "command": "go",
      "args": ["run", "./cmd/osf-mcp"],
      "cwd": "${extensionPath}",
      "env": {
        "OSF_TOKEN": "${OSF_TOKEN}",
        "OSF_USERNAME": "${OSF_USERNAME}",
        "OSF_PASSWORD": "${OSF_PASSWORD}"
      }
    }
  },
  "contextFileName": "GEMINI.md"
}

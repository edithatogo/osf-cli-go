FROM golang:1.26-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/osf-mcp ./cmd/osf-mcp

FROM gcr.io/distroless/static-debian12:nonroot

LABEL org.opencontainers.image.source="https://github.com/edithatogo/osf-cli-go"
LABEL org.opencontainers.image.description="Read-only Open Science Framework MCP server"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL io.modelcontextprotocol.server.name="io.github.edithatogo/osf-cli-go"

COPY --from=build /out/osf-mcp /osf-mcp
USER nonroot:nonroot
ENTRYPOINT ["/osf-mcp"]

{
  "mcpServers": {
    "osf": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run",
        "--rm",
        "-i",
        "-e",
        "OSF_TOKEN=${COPILOT_MCP_OSF_TOKEN}",
